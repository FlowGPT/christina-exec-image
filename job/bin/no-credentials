#!/bin/sh
# 工单 pod 里的 kubectl / aws / docker（同一个脚本的三个名字）：这台机器上没有这类凭据，也不该有。说一句话，退出 1。
name=$(basename "$0")
if [ "$name" = docker ]; then
  echo "这台机器上没有 docker：测试要的 postgres、pgvector、redis 已经装好，直接当进程起（initdb / pg_ctl / redis-server 都在 PATH 里），别的要 docker 的活请把单交回前台。" >&2
else
  echo "这台机器上没有 $name 的凭据，要用就把单交回前台。" >&2
fi
exit 1
